# VNLRAG environment template. Copy to .env and fill secrets.

# Supabase persistence and authentication.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
 # Frontend API routing. Local dev calls FastAPI directly by default; set
 # NEXT_PUBLIC_API_URL to another absolute URL for an intentional deployment
 # override. BACKEND_INTERNAL_URL is only used by the Next.js rewrite when
 # same-origin/container proxying is desired.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenRouter provides the OpenAI-compatible API for chat and embeddings.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GENERATION_MODEL=deepseek/deepseek-v4-flash-0731
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# Local Qdrant storage and serving collection.
QDRANT_PATH=./data/processed/qdrant
QDRANT_COLLECTION=traffic_law

# Retrieval and generation limits.
RETRIEVAL_TOP_K=8
GENERATION_MAX_CONTEXT_TOKENS=12000
GENERATION_MAX_OUTPUT_TOKENS=1500

# Corpus and chunking paths/settings.
LEGAL_MANIFEST=data/sources/manifest.json
LEGAL_CHUNKS=data/processed/chunks.jsonl
CHUNK_SIZE=1200
CHUNK_OVERLAP=120
