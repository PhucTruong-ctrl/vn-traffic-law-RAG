# =============================================================================
# VNLRAG — .env.example (mẫu biến môi trường)
# =============================================================================
# - File .env thật KHÔNG BAO GIỜ được commit (đã nằm trong .gitignore).
# - Sau khi `cp .env.example .env`, đặt quyền: chmod 600 .env (theo doc 07).
# - File này an toàn để commit vì chỉ chứa giá trị mặc định/placeholder.
# =============================================================================

# --- Ứng dụng / Cổng ---
APP_ENV=release
APP_VERSION=v1.0.0-rc2
LOG_LEVEL=INFO
TIMEZONE=Asia/Ho_Chi_Minh
FRONTEND_PORT=3000
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- PostgreSQL ---
POSTGRES_DB=vnlaw
POSTGRES_USER=vnlaw
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://vnlaw:change-me@postgres:5432/vnlaw

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_ALIAS=legal_provisions_active
QDRANT_COLLECTION_PREFIX=legal_provisions

# --- Sparse encoder (doc 03 §3.11.2) ---
# Encoder id recorded in every point's sparse_encoder_version payload key;
# changing it requires a collection rebuild + alias switch.
SPARSE_ENCODER_VERSION=bm25-v1
# Tokenizer implemented by BM25SparseEncoder (only unicode-word exists today).
SPARSE_TOKENIZER=unicode-word

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage ---
# Compose container cần MINIO_ROOT_USER/MINIO_ROOT_PASSWORD; hợp đồng ứng dụng
# dùng S3_* với bí danh tương thích MINIO_*. Hai bộ tên cùng trỏ về cùng một
# đối tượng — thay đổi phải đồng bộ cả hai.
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKETS=source-pdfs,parser-outputs,page-images,ingestion-artifacts,review-artifacts,evaluation-artifacts
S3_USE_SSL=false
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKETS=source-pdfs,parser-outputs,page-images,ingestion-artifacts,review-artifacts,evaluation-artifacts
MINIO_USE_SSL=false

# --- Langfuse ---
# LANGFUSE_ENABLED=false phải KHÔNG BAO GIỜ làm hỏng query (cần fallback).
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Prompt ---
PROMPT_SOURCE=LANGFUSE
FALLBACK_PROMPTS_DIR=/app/prompts/fallback
FALLBACK_PROMPT_VERSION_QUERY_ANALYZER=
FALLBACK_PROMPT_VERSION_QUERY_REWRITER=
FALLBACK_PROMPT_VERSION_HYDE=
FALLBACK_PROMPT_VERSION_GENERATOR=
FALLBACK_PROMPT_VERSION_CLAIM_VERIFIER=

# --- Generator ---
GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
GENERATION_FALLBACK_ENABLED=false

# --- Embedding ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=60

# --- Reranker ---
RERANKER_PROVIDER=jina
RERANKER_MODEL=jina-reranker-v3
RERANKER_BUFFER=4
JINA_API_KEY=

# --- Judge (đánh giá) ---
EVALUATION_JUDGE_PROVIDER=openai
EVALUATION_JUDGE_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_API_KEY=

# --- Bảo mật ---
ADMIN_TOKEN=change-me
MAX_UPLOAD_SIZE_MB=50
PUBLIC_RATE_LIMIT_PER_MINUTE=10
ADMIN_RATE_LIMIT_PER_MINUTE=5

# --- Ingestion ---
# MAX_INGESTION_WORKERS=1 được áp dụng toàn repo theo doc 03 (không đổi).
MAX_INGESTION_WORKERS=1
INGESTION_TIMEOUT_SECONDS=1800

# --- Dramatiq actor time limits (giây) ---
ACTOR_TIME_LIMIT_PARSE=1200
ACTOR_TIME_LIMIT_NORMALIZE=300
ACTOR_TIME_LIMIT_EXTRACT=600
ACTOR_TIME_LIMIT_RESOLVE_REFS=300
ACTOR_TIME_LIMIT_RESOLVE_TEMPORAL=300
ACTOR_TIME_LIMIT_QUALITY_GATE=300
ACTOR_TIME_LIMIT_EMBED=600
ACTOR_TIME_LIMIT_INDEX=300

# --- Query / retrieval ---
EXACT_LOOKUP_ENABLED=true
RETRIEVAL_TOP_K=8
DENSE_PREFETCH=30
SPARSE_PREFETCH=30
RRF_K=60
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0
FUSION_LIMIT=20
TEMPORAL_FILTER=true
GENERATION_MAX_CONTEXT_TOKENS=12000
GENERATION_MAX_OUTPUT_TOKENS=1500
MAX_REPAIR_ATTEMPTS=3

# --- Retention / Ngân sách ---
QUERY_TRACE_RETENTION_DAYS=30
DEVELOPMENT_BUDGET_USD=10
EVALUATION_BUDGET_USD=25
PROJECT_BUDGET_USD=40
