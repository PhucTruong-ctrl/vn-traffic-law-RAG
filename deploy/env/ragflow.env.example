# RAGFlow benchmark-only environment. No credentials are stored here.
RAGFLOW_IMAGE=infiniflow/ragflow:v0.26.4
RAGFLOW_WEB_PORT=8088
RAGFLOW_API_PORT=9380
RAGFLOW_API_HOST=0.0.0.0
