{
  // ===========================================================================
  // oh-my-opencode-slim — project-scoped configuration (VNLRAG v2)
  // ===========================================================================
  // Precedence: built-in < user-global (~/.config/opencode/oh-my-opencode-slim.json)
  //             < THIS project file < env preset override < active preset < agents.*
  // This file is repo-committed so every contributor inherits the same set.
  // Skill ids reference folders already installed globally at
  // ~/.config/opencode/skills/<id>/SKILL.md (105 skills installed 2026-08-08).
  // Stack: Python 3.11 + uv, FastAPI + Pydantic v2, LangGraph, PostgreSQL 18,
  // Qdrant, Redis/Dramatiq, MinIO, Docker Compose, Next.js 16 (TS) frontend,
  // pytest + Playwright, commitlint/husky. Docs-first repo (docs/00-08, ADRs).
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "preset": "vnlaw",
  "presets": {
    "vnlaw": {
      "orchestrator": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "max",
        "skills": [
