  // All skill ids verified present in ~/.config/opencode/skills/.
  // Stack: Python 3.11 + uv, FastAPI + Pydantic v2, LangGraph, PostgreSQL 18,
  // Qdrant, Redis/Dramatiq, MinIO, Docker Compose, Next.js 16 (TS), pytest +
